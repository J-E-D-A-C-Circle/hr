datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model Staff {
  id                  Int        @id @default(autoincrement())
  staff_code          String?    @unique
  full_name           String
  date_of_birth       DateTime?
  gender              String?
  email               String?
  role                String?
  department          String?
  phone               String?
  bank_name           String?
  bank_branch         String?
  bank_account        String?
  salary              Float?
  insurance_provider  String?    @default("Petra")
  insurance_policy_no String?
  insurance_premium   Float?
  payment_status      String?    @default("paid")
  unpaid_reason       String?
  ssnit_no            String?
  nia_number          String?
  created_at          DateTime   @default(now())

  contracts           Contract[]
  validations         StaffValidation[]

  @@map("staff")
}

model StaffValidation {
  id           Int      @id @default(autoincrement())
  staff_id     Int
  month        String
  validated_at DateTime @default(now())
  validated_by String?  @default("Admin")
  notes        String?

  staff        Staff    @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@unique([staff_id, month])
  @@map("staff_validations")
}

model Contract {
  id                 Int       @id @default(autoincrement())
  staff_id           Int
  start_date         DateTime
  end_date           DateTime
  renewal_number     Int       @default(1)
  is_terminated      Boolean   @default(false)
  termination_date   DateTime?
  termination_reason String?
  is_current         Boolean   @default(true)
  created_at         DateTime  @default(now())

  staff              Staff     @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@map("contracts")
}

model DeductionSetting {
  id                    Int      @id @default(1)
  ssnit_employee_rate   Float    @default(5.5)  // 5.5% SSNIT Employee Tier 1
  ssnit_employer_rate   Float    @default(13.0) // 13.0% SSNIT Employer Tier 1
  petra_employee_rate   Float    @default(5.0)  // 5.0% Petra Tier 3 Employee
  petra_employer_rate   Float    @default(5.0)  // 5.0% Petra Tier 3 Employer
  updated_at            DateTime @updatedAt

  @@map("deduction_settings")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  user_name  String   @default("HR Admin")
  user_role  String   @default("HR Manager")
  action     String   // e.g. "CREATE", "RENEW", "BULK_RENEW", "TERMINATE", "REINSTATE", "PAYMENT_STATUS_CHANGE"
  details    String
  staff_id   Int?
  created_at DateTime @default(now())

  @@map("audit_logs")
}

model RetirementDepartment {
  id           Int               @id @default(autoincrement())
  code         String            @unique
  name         String
  type         String            @default("DEPARTMENT") // DEPARTMENT, STATION
  location     String?           @default("Head Office, Accra")
  headOfDept   String?
  description  String?
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt
  staff        RetirementStaff[]

  @@map("retirement_departments")
}

model RetirementStaff {
  id                     Int                   @id @default(autoincrement())
  staffId                String                @unique
  fullName               String
  dateOfBirth            DateTime
  gender                 String                // Male, Female
  departmentId           Int?
  department             RetirementDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentName         String?               // Fallback / denormalized department name
  stationName            String?               // Fallback / denormalized station name
  jobTitle               String
  grade                  String?               // Grade level e.g. "Senior Manager", "Assistant Officer", "Director"
  dateOfFirstAppointment DateTime
  retirementDate         DateTime
  actualRetirementDate   DateTime?
  retirementStatus       String                @default("ACTIVE") // ACTIVE, NEARING_RETIREMENT, DUE_THIS_YEAR, RETIRED
  email                  String?
  phone                  String?
  active                 Boolean               @default(true)
  created_at             DateTime              @default(now())
  updated_at             DateTime              @updatedAt

  alerts                 RetirementAlert[]

  @@map("retirement_staff")
}

model RetirementUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  fullName     String
  username     String   @unique
  passwordHash String
  role         String   @default("HR_OFFICER") // HR_ADMINISTRATOR, HR_OFFICER
  active       Boolean  @default(true)
  lastLogin    DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("retirement_users")
}

model RetirementAlert {
  id           Int             @id @default(autoincrement())
  staffId      Int
  staff        RetirementStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  milestone    String          // 5_YEARS, 3_YEARS, 1_YEAR, 6_MONTHS
  triggeredAt  DateTime        @default(now())
  status       String          @default("UNREAD") // UNREAD, READ, ACKNOWLEDGED
  created_at   DateTime        @default(now())

  @@unique([staffId, milestone])
  @@map("retirement_alerts")
}

model RetirementAuditLog {
  id         Int      @id @default(autoincrement())
  userName   String
  userRole   String
  action     String   // e.g. "CREATE_STAFF", "UPDATE_STAFF", "IMPORT_STAFF", "DEACTIVATE_STAFF", "CREATE_USER", "UPDATE_SETTINGS"
  details    String
  staffId    Int?
  created_at DateTime @default(now())

  @@map("retirement_audit_logs")
}

model RetirementSetting {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt

  @@map("retirement_settings")
}

