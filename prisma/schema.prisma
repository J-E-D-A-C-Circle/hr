datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Staff {
  id                  Int        @id @default(autoincrement())
  staff_code          String?    @unique
  full_name           String
  date_of_birth       DateTime?
  gender              String?
  email               String?
  role                String?
  department          String?
  phone               String?
  bank_name           String?
  bank_branch         String?
  bank_account        String?
  salary              Float?
  insurance_provider  String?    @default("Petra")
  insurance_policy_no String?
  insurance_premium   Float?
  payment_status      String?    @default("paid")
  unpaid_reason       String?
  ssnit_no            String?
  nia_number          String?
  created_at          DateTime   @default(now())

  contracts           Contract[]
  validations         StaffValidation[]

  @@map("staff")
}

model StaffValidation {
  id           Int      @id @default(autoincrement())
  staff_id     Int
  month        String
  validated_at DateTime @default(now())
  validated_by String?  @default("Admin")
  notes        String?

  staff        Staff    @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@unique([staff_id, month])
  @@map("staff_validations")
}

model Contract {
  id                 Int       @id @default(autoincrement())
  staff_id           Int
  start_date         DateTime
  end_date           DateTime
  renewal_number     Int       @default(1)
  is_terminated      Boolean   @default(false)
  termination_date   DateTime?
  termination_reason String?
  is_current         Boolean   @default(true)
  created_at         DateTime  @default(now())

  staff              Staff     @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@map("contracts")
}

model DeductionSetting {
  id                    Int      @id @default(1)
  ssnit_employee_rate   Float    @default(5.5)  // 5.5% SSNIT Employee Tier 1
  ssnit_employer_rate   Float    @default(13.0) // 13.0% SSNIT Employer Tier 1
  petra_employee_rate   Float    @default(5.0)  // 5.0% Petra Tier 3 Employee
  petra_employer_rate   Float    @default(5.0)  // 5.0% Petra Tier 3 Employer
  updated_at            DateTime @updatedAt

  @@map("deduction_settings")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  user_name  String   @default("HR Admin")
  user_role  String   @default("HR Officer")
  action     String   // e.g. "CREATE", "RENEW", "BULK_RENEW", "TERMINATE", "REINSTATE", "PAYMENT_STATUS_CHANGE"
  details    String
  staff_id   Int?
  created_at DateTime @default(now())

  @@map("audit_logs")
}

model RetirementDepartment {
  id           Int               @id @default(autoincrement())
  code         String            @unique
  name         String
  type         String            @default("DEPARTMENT") // DEPARTMENT, STATION
  location     String?           @default("Head Office, Accra")
  headOfDept   String?
  description  String?
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt
  staff        RetirementStaff[]

  @@map("retirement_departments")
}

model RetirementStaff {
  id                     Int                   @id @default(autoincrement())
  staffId                String                @unique
  fullName               String
  dateOfBirth            DateTime
  gender                 String                // Male, Female
  departmentId           Int?
  department             RetirementDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentName         String?               // Fallback / denormalized department name
  stationName            String?               // Fallback / denormalized station name
  jobTitle               String
  grade                  String?               // Grade level e.g. "Senior Manager", "Assistant Officer", "Director"
  dateOfFirstAppointment DateTime
  retirementDate         DateTime
  actualRetirementDate   DateTime?
  retirementStatus       String                @default("ACTIVE") // ACTIVE, NEARING_RETIREMENT, DUE_THIS_YEAR, RETIRED
  email                  String?
  phone                  String?
  active                 Boolean               @default(true)
  created_at             DateTime              @default(now())
  updated_at             DateTime              @updatedAt

  alerts                 RetirementAlert[]

  @@map("retirement_staff")
}

model RetirementUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  fullName     String
  username     String   @unique
  passwordHash String
  role         String   @default("HR_OFFICER") // HR_ADMINISTRATOR, HR_OFFICER
  active       Boolean  @default(true)
  lastLogin    DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("retirement_users")
}

model RetirementAlert {
  id           Int             @id @default(autoincrement())
  staffId      Int
  staff        RetirementStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  milestone    String          // 5_YEARS, 3_YEARS, 1_YEAR, 6_MONTHS
  triggeredAt  DateTime        @default(now())
  status       String          @default("UNREAD") // UNREAD, READ, ACKNOWLEDGED
  created_at   DateTime        @default(now())

  @@unique([staffId, milestone])
  @@map("retirement_alerts")
}

model RetirementAuditLog {
  id         Int      @id @default(autoincrement())
  userName   String
  userRole   String
  action     String   // e.g. "CREATE_STAFF", "UPDATE_STAFF", "IMPORT_STAFF", "DEACTIVATE_STAFF", "CREATE_USER", "UPDATE_SETTINGS"
  details    String
  staffId    Int?
  created_at DateTime @default(now())

  @@map("retirement_audit_logs")
}

model RetirementSetting {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt

  @@map("retirement_settings")
}

model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  name         String
  passwordHash String
  status       String    @default("ACTIVE") // ACTIVE, SUSPENDED
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

model TempStaffUser {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  name         String
  role         String    @default("HR Officer")
  passwordHash String
  status       String    @default("ACTIVE") // ACTIVE, SUSPENDED
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("tempstaff_users")
}

model SystemAnnouncement {
  id          String    @id @default(uuid())
  title       String
  message     String
  target      String    @default("ALL") // ALL, TEMPSTAFF, RETIREMENT
  severity    String    @default("INFO") // INFO, WARNING, CRITICAL
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  createdBy   String

  @@map("system_announcements")
}

model BankMaster {
  id         Int      @id @default(autoincrement())
  bankName   String
  branchName String
  code       String?  @unique
  createdAt  DateTime @default(now())

  @@map("bank_masters")
}

model InsuranceProvider {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  policyType     String   @default("TIER_3")
  defaultPremium Float    @default(0.0)
  createdAt      DateTime @default(now())

  @@map("insurance_providers")
}

model ClearanceItem {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  requiredDept String
  order        Int      @default(1)
  createdAt    DateTime @default(now())

  @@map("clearance_items")
}

model RetirementGrade {
  id            Int      @id @default(autoincrement())
  gradeName     String   @unique
  pensionFactor Float    @default(1.0)
  description   String?
  createdAt     DateTime @default(now())

  @@map("retirement_grades")
}

// ─────────────────────────────────────────────────────────────────────────────
// HR LETTERS MODULE
// ─────────────────────────────────────────────────────────────────────────────

model HrLetterUser {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  fullName     String
  passwordHash String
  role         String    @default("HR_OFFICER") // HR_OFFICER, HR_DIRECTOR
  active       Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("hr_letter_users")
}

model HrLetterStaff {
  id              String              @id @default(uuid())
  staffId         String              @unique
  fullName        String
  department      String
  jobTitle        String
  email           String              @unique
  phone           String
  appointmentDate String
  status          String              @default("ACTIVE") // ACTIVE, PROBATION, ON_LEAVE, TERMINATED
  salaryGrade     String?
  reportingOfficer String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  letters         HrLetterDocument[]

  @@map("hr_letter_staff")
}

model HrLetterTemplate {
  id          String             @id @default(uuid())
  title       String
  type        String             // APPOINTMENT, PROMOTION, CONFIRMATION, TRANSFER, WARNING, LEAVE_APPROVAL, CONTRACT_RENEWAL
  description String?
  content     String             @db.Text
  version     Int                @default(1)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  letters     HrLetterDocument[]

  @@map("hr_letter_templates")
}

model HrLetterDocument {
  id               String               @id @default(uuid())
  staffId          String
  staff            HrLetterStaff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  templateId       String?
  template         HrLetterTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  verificationCode String               @unique
  title            String
  letterType       String               // APPOINTMENT, PROMOTION, CONFIRMATION, TRANSFER, WARNING, LEAVE_APPROVAL, CONTRACT_RENEWAL
  content          String               @db.Text
  salutation       String?              @default("Dear Sir/Madam,")
  customRefNumber  String?
  yourRef          String?
  effectiveDate    String?
  salaryGrade      String?
  status           String               @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, ISSUED, ACKNOWLEDGED, REJECTED
  qrCodeData       String?              @db.Text
  digitalSignature String?              @db.LongText
  signatoryName    String?
  signatoryTitle   String?
  signatoryForTitle String?
  ccText           String?              @db.Text
  applicantAddress String?
  signedAt         DateTime?
  issuedAt         DateTime?
  acknowledgedAt   DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  approvalWorkflows HrApprovalWorkflow[]

  @@map("hr_letter_documents")
}

model HrApprovalWorkflow {
  id           String           @id @default(uuid())
  letterId     String
  letter       HrLetterDocument @relation(fields: [letterId], references: [id], onDelete: Cascade)
  stepNumber   Int
  approverRole String
  approverName String
  status       String           @default("PENDING") // PENDING, APPROVED, REJECTED
  comments     String?          @db.Text
  decidedAt    DateTime?
  createdAt    DateTime         @default(now())

  @@map("hr_approval_workflows")
}

model HrLetterAuditLog {
  id         String   @id @default(uuid())
  action     String
  actorName  String
  actorRole  String
  targetId   String?
  targetType String?
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  @@map("hr_letter_audit_logs")
}

